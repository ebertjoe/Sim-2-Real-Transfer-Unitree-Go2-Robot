            <joint name="RL_calf_joint" class="knee" damping="0.01"/>
            <!-- PATCH: RL calf rotor (URDF: RL_calf_rotor_joint xyz="0 -0.03235 0") -->
            <body name="RL_calf_rotor" pos="0 -0.03235 0">
