            <joint name="FR_calf_joint" class="knee" damping="0.01"/>
            <!-- PATCH: FR calf rotor (URDF: FR_calf_rotor_joint xyz="0 0.03235 0") -->
            <body name="FR_calf_rotor" pos="0 0.03235 0">
