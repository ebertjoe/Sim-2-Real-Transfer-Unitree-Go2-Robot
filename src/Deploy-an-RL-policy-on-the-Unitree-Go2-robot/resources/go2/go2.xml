          <joint name="RL_thigh_joint" class="back_hip" damping="0.01"/>
          <!-- PATCH: RL thigh rotor (URDF: RL_thigh_rotor_joint xyz="0 -0.00015 0") -->
          <body name="RL_thigh_rotor" pos="0 -0.00015 0">
