          <geom size="0.1065 0.01225 0.017" pos="0 0 -0.1065" quat="0.707107 0 0.707107 0" type="box" class="collision" />
          <body name="RR_calf" pos="0 0 -0.213">
            <inertial pos="0.00548 0.000975 -0.115" mass="0.154"
