          fullinertia="9.6e-06 9.6e-06 9.6e-06 0 0 0"/>
      </body>

      <!-- PATCH: FR hip rotor (URDF: FR_hip_rotor_joint xyz="0.11215 -0.04675 0") -->
      <body name="FR_hip_rotor" pos="0.11215 -0.04675 0">
        <inertial pos="0 0 0" mass="0.089"
          fullinertia="0.000111842 0.000059647 0.000059647 0 0 0"/>
