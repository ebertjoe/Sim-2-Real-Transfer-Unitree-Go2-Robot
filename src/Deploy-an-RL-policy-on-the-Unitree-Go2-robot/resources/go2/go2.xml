            <geom name="FR" class="foot" />
            <body name="FR_foot" pos="0 0 -0.213" />
            <site name="FR_foot_site" pos="0 0 -0.213"/>
          </body>
        </body>
      </body>

      <!-- FL leg: front left — qpos[10:13] -->
      <body name="FL_hip" pos="0.1934 0.0465 0">
