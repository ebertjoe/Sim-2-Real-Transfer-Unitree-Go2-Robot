<mujoco model="go2">
  <!--
    Patched for sim2sim transfer from Isaac Sim / URDF.
    Changes vs original go2.xml:
      1. Added 12 motor rotor bodies (mass=0.089 kg, full inertia tensors from URDF)
         so MuJoCo sees the same reflected inertia as PhysX.
         Rotor positions match URDF *_rotor_joint origins exactly.
      2. Made joint damping explicit (damping="0.01") — was already the default
         class value but now visible/overridable per-joint.
      3. Added velocity limits to actuators (hip vel=30.1, knee vel=15.70)
         matching URDF joint limit velocity fields.
      4. Added Head_upper, Head_lower, radar, front_camera as zero-mass fixed
         bodies so body name lookups match between URDF and MJCF.
      5. Renamed base_link -> base to match URDF root link name.
         (revert if your MuJoCo code hardcodes "base_link")
      6. Added explicit damping on knee joints (damping="0.01") — same value
         but now survives if default class is ever changed.
      7. [BUGFIX] radar and front_camera inertia changed from mass=0/zero-tensor
         to mass=0.001/tiny diagonal — MuJoCo requires positive-definite inertia.

    NOT changed (intentional):
      - condim=6, friction, priority on foot geoms — these are MuJoCo-specific
        tuning with no URDF equivalent; keep them.
      - armature="0.01" kept alongside rotor bodies — armature adds to diagonal
        inertia; with rotors present you may want to set armature="0" to avoid
        double-counting. Test both; comment below marks the line.
      - cone="elliptic", impratio=100 — MuJoCo solver tuning, keep as-is.
      - Mesh format (.obj) unchanged — re-export from .dae if needed.
  -->

  <compiler angle="radian" meshdir="assets" autolimits="true" />

  <option cone="elliptic" impratio="100" />

  <default>
    <default class="go2">
      <geom friction="1.0" margin="0.001" condim="1"/>
      <!-- damping and armature explicit here; set armature="0" if rotor bodies
           are providing all reflected inertia and you want no double-counting -->
      <joint axis="0 1 0" damping="0.01" armature="0.01" frictionloss="0.0"/>
      <motor ctrlrange="-23.7 23.7"/>
      <default class="abduction">
        <joint axis="1 0 0" range="-1.0472 1.0472"/>
      </default>
      <default class="hip">
        <default class="front_hip">
          <joint range="-1.5708 3.4907" />
        </default>
        <default class="back_hip">
          <joint range="-0.5236 4.5379"/>
        </default>
      </default>
      <default class="knee">
        <joint range="-2.7227 -0.83776" damping="0.01"/>
        <motor ctrlrange="-45.43 45.43"/>
      </default>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <geom group="3"/>
        <default class="foot">
          <geom size="0.022" pos="-0.002 0 -0.213" priority="1" condim="6"
            friction="1.0 0.02 0.01"/>
        </default>
      </default>
      <!-- zero-mass placeholder for sensor/aux frames -->
      <default class="aux_frame">
        <geom contype="0" conaffinity="0" group="0" size="0.001"/>
      </default>
    </default>
  </default>

  <asset>
    <material name="metal" rgba=".9 .95 .95 1" />
    <material name="black" rgba="0 0 0 1" />
    <material name="white" rgba="1 1 1 1" />
    <material name="gray" rgba="0.671705 0.692426 0.774270 1" />
    <material name="grid_mat" texture="grid" texrepeat="10 10" texuniform="true" rgba="1 1 1 1"/>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1="0.8 0.8 0.8" rgb2="0.2 0.2 0.2"/>
    <mesh file="base_0.obj" />
    <mesh file="base_1.obj" />
    <mesh file="base_2.obj" />
    <mesh file="base_3.obj" />
    <mesh file="base_4.obj" />
    <mesh file="hip_0.obj" />
    <mesh file="hip_1.obj" />
    <mesh file="thigh_0.obj" />
    <mesh file="thigh_1.obj" />
    <mesh file="thigh_mirror_0.obj" />
    <mesh file="thigh_mirror_1.obj" />
    <mesh file="calf_0.obj" />
    <mesh file="calf_1.obj" />
    <mesh file="calf_mirror_0.obj" />
    <mesh file="calf_mirror_1.obj" />
    <mesh file="foot.obj" />
  </asset>

  <worldbody>
    <!-- PATCH: renamed base_link -> base to match URDF root link name -->
    <body name="base" pos="0 0 0.42" childclass="go2">
      <camera name="follow_cam" pos="-1.5 -0 1.8" euler="0 -0.870 -1.570" mode="trackcom" />
      <inertial pos="0.021112 0 -0.005366" mass="6.921"
        fullinertia="0.02448 0.098077 0.107 0.00012166 0.0014849 -0.0000312" />
      <freejoint />
      <geom mesh="base_0" material="black" class="visual" />
      <geom mesh="base_1" material="black" class="visual" />
      <geom mesh="base_2" material="black" class="visual" />
      <geom mesh="base_3" material="white" class="visual" />
      <geom mesh="base_4" material="gray" class="visual" />
      <geom size="0.1881 0.04675 0.057" type="box" class="collision" />
      <geom size="0.05 0.045" pos="0.285 0 0.01" type="cylinder" class="collision" />
      <geom size="0.047" pos="0.293 0 -0.06" class="collision" />
      <site name="imu" pos="-0.02557 0 0.04232" />

      <!-- PATCH: Head_upper — zero-mass fixed frame (matches URDF Head_upper_joint) -->
      <body name="Head_upper" pos="0.285 0 0.01">
        <inertial pos="0 0 0" mass="0.001"
          fullinertia="9.6e-06 9.6e-06 9.6e-06 0 0 0"/>
        <geom size="0.05 0.045" type="cylinder" class="collision" />
        <!-- PATCH: Head_lower chained (matches URDF Head_lower_joint xyz="0.008 0 -0.07") -->
        <body name="Head_lower" pos="0.008 0 -0.07">
          <inertial pos="0 0 0" mass="0.001"
            fullinertia="9.6e-06 9.6e-06 9.6e-06 0 0 0"/>
          <geom size="0.047" type="sphere" class="collision" />
        </body>
      </body>

      <!-- PATCH: radar frame (matches URDF radar_joint xyz="0.28945 0 -0.046825" rpy="0 2.8782 0") -->
      <!-- BUGFIX: was mass=0/zero-tensor which MuJoCo rejects; use tiny positive inertia -->
      <body name="radar" pos="0.28945 0 -0.046825" euler="0 2.8782 0">
        <inertial pos="0 0 0" mass="0.001"
          fullinertia="9.6e-06 9.6e-06 9.6e-06 0 0 0"/>
      </body>

      <!-- PATCH: front_camera frame (matches URDF front_camera_joint xyz="0.32715 -0.00003 0.04297") -->
      <!-- BUGFIX: was mass=0/zero-tensor which MuJoCo rejects; use tiny positive inertia -->
      <body name="front_camera" pos="0.32715 -0.00003 0.04297">
