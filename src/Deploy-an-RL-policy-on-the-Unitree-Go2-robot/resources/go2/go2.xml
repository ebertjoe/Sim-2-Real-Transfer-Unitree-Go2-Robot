          <joint name="FL_thigh_joint" class="front_hip" damping="0.01"/>
          <!-- PATCH: FL thigh rotor (URDF: FL_thigh_rotor_joint xyz="0 -0.00015 0") -->
          <body name="FL_thigh_rotor" pos="0 -0.00015 0">
            <inertial pos="0 0 0" mass="0.089"
              fullinertia="0.000059647 0.000111842 0.000059647 0 0 0"/>
          </body>
          <geom mesh="thigh_0" material="metal" class="visual" />
          <geom mesh="thigh_1" material="gray" class="visual" />
          <geom size="0.1065 0.01225 0.017" pos="0 0 -0.1065" quat="0.707107 0 0.707107 0" type="box" class="collision" />
          <body name="FL_calf" pos="0 0 -0.213">
            <inertial pos="0.00548 -0.000975 -0.115" mass="0.154"
